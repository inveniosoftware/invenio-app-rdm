# Workflow: backend extract, pull and compile
# Requires an authenticated Transifex CLI.
# 1) $ cd "$(git rev-parse --show-toplevel)"
# 2) $ pybabel extract -F pyproject.toml -o invenio_app_rdm/translations/messages.pot invenio_app_rdm
# 3) $ tx pull -a
# 4) $ pybabel compile -d invenio_app_rdm/translations

# Workflow: frontend extract, pull and compile (from repository root)
# 1) $ cd invenio_app_rdm/theme/assets/semantic-ui/translations/invenio_app_rdm
# 2) $ npm ci
# 3) $ npm run extract_messages
# 4) Parentheses run in a subshell, keeping your current directory:
#    $ (cd "$(git rev-parse --show-toplevel)" && tx pull -a)
#    # Still in the frontend translation directory.
# 5) $ npm run compile_catalog

# Optional workflow: push extracted sources
# 1) $ cd "$(git rev-parse --show-toplevel)"
# 2) $ tx push -s

# Optional workflow: new backend language
# 1) $ cd "$(git rev-parse --show-toplevel)"
# 2) $ pybabel init -i invenio_app_rdm/translations/messages.pot -d invenio_app_rdm/translations -l <lang>
# 3) Translate the PO file, then compile:
#    $ pybabel compile -d invenio_app_rdm/translations -l <lang>

# Add languages in Transifex, then pull.
# Optional: local frontend language (development only, from repository root)
# 1) $ cd invenio_app_rdm/theme/assets/semantic-ui/translations/invenio_app_rdm
# 2) $ npm ci
# 3) $ npm run init_catalog lang <lang>
# 4) $ npm run extract_messages
# 5) Translate the PO file, then compile:
#    $ npm run compile_catalog lang <lang>

[main]
host = https://app.transifex.com

[o:inveniosoftware:p:invenio:r:invenio-app-rdm-messages]
file_filter = invenio_app_rdm/translations/<lang>/LC_MESSAGES/messages.po
source_file = invenio_app_rdm/translations/messages.pot
source_lang = en
type = PO


[o:inveniosoftware:p:invenio:r:invenio-app-rdm-messages-ui]
file_filter = invenio_app_rdm/theme/assets/semantic-ui/translations/invenio_app_rdm/messages/<lang>/messages.po
source_file = invenio_app_rdm/theme/assets/semantic-ui/translations/invenio_app_rdm/translations.pot
source_lang = en
type = PO
